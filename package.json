{
  "name": "portfolio-app",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "hooks:install": "git config core.hooksPath .githooks && echo 'git hooks -> .githooks'",
    "generate:version": "node scripts/generate-version.mjs",
    "postinstall": "node scripts/generate-version.mjs",
    "prestart": "node scripts/generate-version.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/generate-version.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "api:types": "openapi-typescript src/app/core/api/openapi.yaml -o src/app/core/api/generated/contract.ts && prettier --write src/app/core/api/generated/contract.ts",
    "hooks:agent": "mkdir -p .claude/hooks && cp .githooks/agent/settings.json .claude/settings.json && cp .githooks/agent/guard-write.sh .githooks/agent/guard-bash.sh .claude/hooks/ && chmod +x .claude/hooks/*.sh && echo 'agent guards installed -> .claude/'"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngrx/signals": "^21.1.1",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
