#!/usr/bin/env bash
# commit-msg — the history is a document; keep it readable and traceable back
# to the build ledger.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
# shellcheck source=/dev/null
. .githooks/_lib.sh

MSG_FILE=$1
SUBJECT=$(head -n1 "$MSG_FILE")

# Merge/revert/fixup commits are generated by git — leave them alone.
case "$SUBJECT" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

# ── Conventional Commits ─────────────────────────────────────────────────────
if ! printf '%s' "$SUBJECT" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\([a-z0-9._-]+\))?!?: .+'; then
  fail "Subject is not a Conventional Commit." \
    "Got:      $SUBJECT" \
    "Expected: type(scope): summary        e.g. feat(gym): add the history list [P1-7]" \
    "Types: feat fix docs style refactor perf test build ci chore"
fi

# ── Length ───────────────────────────────────────────────────────────────────
if [ "${#SUBJECT}" -gt 72 ]; then
  fail "Subject is ${#SUBJECT} characters (max 72)." \
    "Move the detail into the commit body — a blank line, then prose."
fi

# ── Traceability to the ledger ───────────────────────────────────────────────
# CONVENTIONS: "One step = one focused commit ... referencing the step ID".
# A warning, not a block: plenty of legitimate commits (docs, chores, hotfixes)
# belong to no ledger step.
if git diff --cached --name-only --diff-filter=ACMRD -- 'src/*' 'public/*' | grep -q .; then
  if ! grep -qE '\[(P[0-9]+-[0-9]+|H-[0-9]+)\]' "$MSG_FILE"; then
    warn "Code changed but no build-ledger step ID in the message." \
      "If this implements a step, reference it: ... [P1-7]" \
      "docs/build/TASKS.md is the list."
  fi
fi

finish
