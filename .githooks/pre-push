#!/usr/bin/env bash
# pre-push — the real gate. This is the last point before code becomes other
# people's problem, so it runs the project's full Definition of Done rather
# than a fast subset. Expect ~30-60s.
#
# Escape hatch: SKIP_PREPUSH=1 git push   (CI runs the same checks; skipping
# here only changes *where* you find out.)

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
# shellcheck source=/dev/null
. .githooks/_lib.sh

if [ "${SKIP_PREPUSH:-0}" = "1" ]; then
  warn "SKIP_PREPUSH=1 — full checks skipped. CI will still run them."
  exit 0
fi

# Deleting a remote branch pushes no commits; nothing to verify.
PUSHING_SOMETHING=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" != "0000000000000000000000000000000000000000" ] && PUSHING_SOMETHING=1
done
[ "$PUSHING_SOMETHING" -eq 0 ] && exit 0

if [ ! -d node_modules ]; then
  fail "node_modules is missing — cannot verify this push." "Run: npm ci"
  finish
fi

run() {
  label=$1; shift
  note "$label ..."
  if ! output=$("$@" 2>&1); then
    fail "$label failed." "$(printf '%s' "$output" | tail -n 25)"
    return 1
  fi
  return 0
}

run "format:check" npm run --silent format:check
run "typecheck"    npm run --silent typecheck
run "tests"        npm test
run "build"        npm run --silent build

# ── Contract drift ───────────────────────────────────────────────────────────
# The generated client is only trustworthy if it still matches the spec. CI
# doesn't check this today, so the push gate does.
note "contract drift ..."
npm run --silent api:types >/dev/null 2>&1
if ! git diff --quiet -- src/app/core/api/generated/contract.ts; then
  fail "Generated API types are out of date with openapi.yaml." \
    "The regenerated file is in your working tree — review, commit, push again."
fi

finish
